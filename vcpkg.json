{
  "dependencies": [
    {
      "name": "carbon-blueexposure",
      "version>=": "2.1.1"
    },
    {
      "name": "carbon-core",
      "version>=": "3.0.0"
    },
    {
      "name": "carbon-pdmprotowrapper",
      "version>=": "2.0.4"
    },
    {
      "name": "gtest",
      "version>=": "1.16.0"
    },
    "openssl",
    {
      "name": "libyaml",
      "version>=": "0.2.5#5"
    },
    {
      "name": "zlib",
      "version>=": "2.2.5"
    },
    {
      "name": "curl",
      "version>=": "7.78.0",
      "features": [
        {
          "name": "schannel",
          "platform": "windows"
        }
      ]
    }
  ],
  "default-features": [
    "python"
  ],
  "features": {
    "python": {
      "description": "Python backend: the blue extension module, Stackless tasklets and the Python-bound tests",
      "dependencies": [
        {
          "name": "carbon-io",
          "version>=": "1.3.1"
        },
        {
          "name": "carbon-scheduler",
          "version>=": "1.4.3"
        },
        {
          "name": "carbon-exefile",
          "version>=": "4.1.1",
          "host": true
        },
        {
          "name": "python3",
          "version>=": "3.12.9#1"
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "protobuf",
      "version": "3.6.0.1"
    },
    {
      "name": "openssl",
      "version": "1.1.1k#8"
    }
  ]
}
